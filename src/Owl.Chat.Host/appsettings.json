{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RunMigration": true,
  "ConnectionStrings": {
    "Type": "sqlite",
    "Default": "Data Source=ThorChat.db"
  },
  "Jwt": {
    "Issuer": "ThorChat",
    "Audience": "ThorChat",
    "Secret": "alkjsdklalsdnkojhn01u91n3ob8gihiu)&*()Y&&*(y123JBHJIKBYHUIAYB95a1KLDN",
    "ExpireDay": 14,
    "RefreshExpireDay": 20
  },
  "Session": {
    "Model": "gpt-4o",
    "RenameModel": "gpt-4o-mini"
  },
  "Storage": {
    "Type": "LiteDB"
  },
  "Googel": {
    "Enabled": false,
    "ClientId": "",
    "ClientSecret": ""
  },
  "Thor": {
    "Enabled": true,
    "Host": "https://api.token-ai.cn/"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss} [{Level}] {Message}{NewLine}{Exception}"
        }
      }
    ]
  }
}
