        <ProjectReference Include="..\EntityFrameworkCore\EntityFrameworkCore.MySql\EntityFrameworkCore.MySql.csproj" />
        <ProjectReference Include="..\EntityFrameworkCore\EntityFrameworkCore.PostgreSQL\EntityFrameworkCore.PostgreSQL.csproj" />
        <ProjectReference Include="..\EntityFrameworkCore\EntityFrameworkCore.Sqlite\EntityFrameworkCore.Sqlite.csproj" />
        <ProjectReference Include="..\EntityFrameworkCore\EntityFrameworkCore.SqlServer\EntityFrameworkCore.SqlServer.csproj" />
        <ProjectReference Include="..\Storage\Storage.Core\Storage.Core.csproj" />
        <ProjectReference Include="..\Storage\Storage.LiteDB\Storage.LiteDB.csproj" />
        <ProjectReference Include="..\Owl.Chat.Core\Owl.Chat.Core.csproj" />
